<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dcp.backup</string>

    <!-- The passphrase is sourced from a file outside the repository so
         it never reaches git and never appears in argv. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "$HOME/Code/hoyla_github/datacentre_planning" &amp;&amp; set -a &amp;&amp; . "$HOME/.config/datacentre_planning/backup.env" &amp;&amp; set +a &amp;&amp; .venv/bin/python scripts/backup_db.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Absolute, and deliberately not $HOME: launchd does no variable
         expansion in these two keys, unlike the command above, which is
         a zsh string and does. Which means these are the one part of
         this file that is specific to the machine it was last edited
         on — check them before `cp`ing it into ~/Library/LaunchAgents
         (docs/BACKUP.md), or the job fails to start with nowhere to
         say so. -->
    <key>StandardOutPath</key>
    <string>/Users/hoyla/Code/hoyla_github/datacentre_planning/logs/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hoyla/Code/hoyla_github/datacentre_planning/logs/backup.log</string>

    <!-- Deliberately absent: RunAtLoad. A backup should happen on a
         schedule, not every time someone logs in. And no KeepAlive — if
         the laptop is asleep at 03:00 the run is skipped rather than
         queued, which is why `backup_db.py --list` reports the age of
         the newest off-site copy. -->
</dict>
</plist>
