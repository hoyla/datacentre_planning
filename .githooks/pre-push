#!/bin/sh
# Push safety, by the state of the branch's pull request.
#
#   main       never — main moves by merging a PR, nothing else
#   no PR      safe to push
#   draft PR   safe to push
#   ready PR   do not push without asking first
#   merged PR  never push
#
# The last two are the ones that bite. A push to a merged branch is
# stranded — not in main, on a branch nobody will open again, and with
# every appearance of having worked. A push to a branch under review
# changes what a reviewer is looking at while they look at it.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Deliberate override, for the rare case where the answer really is yes:
#     ALLOW_MERGED_PUSH=1 git push …

branch=$(git rev-parse --abbrev-ref HEAD)

# The default branch, first, and without asking gh anything. This hook
# reasoned only about pull request states, so a push straight to main
# sailed past it — twice on 2026-08-26, the second time an hour after
# the rule was restated and written down. GitHub's own "changes must be
# made through a pull request" rule does not stop it either: an admin
# push is recorded as "Bypassed rule violations" and goes through. A
# rule nothing enforces is a rule that gets broken by whoever is moving
# fastest.
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  cat >&2 <<EOF

  Refusing to push $branch directly.

  main moves by merging a pull request, never by a push. Put the work on
  a branch and open one:

      git branch <name>            # keep the commits
      git reset --hard origin/main # rewind main to the remote
      git checkout <name>
      git push -u origin <name>

EOF
  exit 1
fi

[ "$ALLOW_MERGED_PUSH" = "1" ] && exit 0
command -v gh >/dev/null 2>&1 || exit 0     # no gh, no opinion

info=$(gh pr view "$branch" --json state,isDraft,number,url 2>/dev/null) || exit 0
[ -z "$info" ] && exit 0                    # no PR: safe

state=$(printf '%s' "$info" | sed -n 's/.*"state":"\([A-Z]*\)".*/\1/p')
draft=$(printf '%s' "$info" | sed -n 's/.*"isDraft":\([a-z]*\).*/\1/p')
url=$(printf '%s' "$info" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')

case "$state" in
  MERGED)
    cat >&2 <<EOF

  Refusing to push. The pull request for '$branch' has MERGED.
  $url

  Anything pushed here is stranded: not in main, on a branch nobody will
  read again, and looking for all the world as though it worked.

  Start again from main:

      git checkout -b <new-branch> origin/main
      git cherry-pick <commits>

EOF
    exit 1 ;;
  OPEN)
    [ "$draft" = "true" ] && exit 0         # draft: safe
    cat >&2 <<EOF

  Refusing to push. '$branch' has a pull request that is READY for review.
  $url

  Pushing now changes what a reviewer is reading while they read it. Ask
  first, or put the PR back into draft:

      gh pr ready --undo $branch

  Then push again.

EOF
    exit 1 ;;
  CLOSED)
    cat >&2 <<EOF

  Refusing to push. The pull request for '$branch' was CLOSED unmerged.
  $url

  Reopen it deliberately, or branch afresh from main.

EOF
    exit 1 ;;
esac

exit 0
